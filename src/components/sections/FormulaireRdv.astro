---
import Field from '../ui/Field.astro';
import { contact, professions } from '../../data/site';

/**
 * Alternative native à l'agenda en ligne.
 *
 * L'embed Calendly reste le chemin principal : il réserve directement, sans
 * échange. Mais l'audience arrive par le navigateur intégré d'Instagram, sur
 * téléphone, souvent tard le soir : les iframes tierces y sont peu fiables, et
 * choisir un créneau engage plus que demander un rappel. Ce formulaire évite
 * de perdre ces visiteuses.
 */

const emailContact = contact.email ?? 'notre adresse de contact';

const disponibilites = [
  { valeur: 'matin', label: 'Le matin' },
  { valeur: 'apres-midi', label: 'L’après-midi' },
  { valeur: 'soiree', label: 'En soirée' },
  { valeur: 'indifferent', label: 'Indifférent' },
];
---

<div
  data-formulaire-rdv
  class="rounded-[4px] border border-papier-200 bg-craie p-6 md:p-8"
>
  <form novalidate class="space-y-5">
    <Field
      nom="nom"
      label="Prénom et nom"
      requis
      autocomplete="name"
    />
    <Field
      nom="email"
      label="Adresse e-mail"
      type="email"
      requis
      autocomplete="email"
    />
    <Field
      nom="telephone"
      label="Téléphone"
      type="tel"
      requis
      autocomplete="tel"
      aide="C’est le numéro sur lequel nous vous appellerons."
    />
    <Field
      nom="profession"
      label="Votre profession"
      type="select"
      requis
      options={professions.map((p) => ({ valeur: p.valeur, label: p.label }))}
    />
    <Field
      nom="disponibilites"
      label="Quand pouvons-nous vous joindre ?"
      type="select"
      requis
      options={disponibilites}
    />

    <fieldset>
      <legend class="mb-1.5 font-semibold">
        Avez-vous lu le tarif du programme sur le site&nbsp;?
      </legend>
      <p class="mb-2.5 text-[0.875rem] text-encre-500">
        Aucune mauvaise réponse&nbsp;: cela nous dit simplement par où commencer
        l’appel.
      </p>
      <div class="flex gap-6">
        {
          [
            { valeur: 'oui', label: 'Oui' },
            { valeur: 'non', label: 'Non, pas encore' },
          ].map((option) => (
            <label class="flex min-h-[44px] items-center gap-2.5">
              <input
                type="radio"
                name="tarifLu"
                value={option.valeur}
                class="h-5 w-5 shrink-0 accent-encre-700"
              />
              <span>{option.label}</span>
            </label>
          ))
        }
      </div>
      <p
        data-erreur-champ="tarifLu"
        aria-live="polite"
        class="mt-1.5 text-[0.875rem] text-or-600 empty:mt-0"
      >
      </p>
    </fieldset>

    <Field
      nom="message"
      label="Quelque chose à nous dire avant l’appel"
      type="textarea"
      lignes={3}
    />

    {/* Honeypot : invisible, hors tabulation, jamais renseigné par un humain. */}
    <div aria-hidden="true" class="absolute -left-[9999px]">
      <label for="societe-rdv">Société</label>
      <input
        id="societe-rdv"
        name="societe"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="flex gap-3 pt-1">
      <input
        id="consentement-rdv"
        name="consentement"
        type="checkbox"
        required
        class="mt-1 h-5 w-5 shrink-0 rounded-[2px] border border-papier-200 accent-encre-700"
      />
      <label
        for="consentement-rdv"
        class="text-[0.9375rem] leading-relaxed text-encre-700"
      >
        J’accepte d’être recontactée par La Seconde Blouse au sujet de cet appel.
        <a href="/confidentialite" class="underline underline-offset-2">
          Politique de confidentialité
        </a>
      </label>
    </div>
    <p
      data-erreur-champ="consentement"
      aria-live="polite"
      class="text-[0.875rem] text-or-600 empty:hidden"
    >
    </p>

    <button
      type="submit"
      data-bouton-envoi
      class="bouton bouton-primaire w-full sm:w-auto"
    >
      Demander à être rappelée
    </button>

    <p
      data-message-global
      role="status"
      aria-live="polite"
      class="text-[0.9375rem] text-encre-700 empty:hidden"
    >
    </p>
  </form>

  <div data-succes hidden>
    <p class="eyebrow mb-3 text-or-600">Demande enregistrée</p>
    <h3 class="mb-3">C’est noté.</h3>
    <p class="text-encre-700">
      Oumaya vous rappelle sur le créneau que vous avez indiqué. L’appel dure 30
      minutes, il est gratuit et sans engagement, et vous pouvez dire non à
      tout moment, y compris avant qu’il commence.
    </p>
  </div>
</div>

<script is:inline define:vars={{ emailContact }}>
  const bloc = document.querySelector('[data-formulaire-rdv]');
  const formulaire = bloc?.querySelector('form');

  if (formulaire) {
    const bouton = formulaire.querySelector('[data-bouton-envoi]');
    const messageGlobal = formulaire.querySelector('[data-message-global]');
    const succes = bloc.querySelector('[data-succes]');
    const rendu = Date.now();

    const viderErreurs = () => {
      formulaire
        .querySelectorAll('[data-erreur-champ]')
        .forEach((element) => (element.textContent = ''));
      formulaire
        .querySelectorAll('[aria-invalid]')
        .forEach((element) => element.removeAttribute('aria-invalid'));
    };

    const poserErreur = (champ, message) => {
      const cible = formulaire.querySelector(`[data-erreur-champ="${champ}"]`);
      if (cible) cible.textContent = message;
      const controle = formulaire.elements.namedItem(champ);
      if (controle && 'setAttribute' in controle) {
        controle.setAttribute('aria-invalid', 'true');
      }
    };

    formulaire.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      viderErreurs();
      if (messageGlobal) messageGlobal.textContent = '';

      const donnees = new FormData(formulaire);
      const charge = {
        nom: String(donnees.get('nom') ?? '').trim(),
        email: String(donnees.get('email') ?? '').trim(),
        telephone: String(donnees.get('telephone') ?? '').trim(),
        profession: String(donnees.get('profession') ?? ''),
        disponibilites: String(donnees.get('disponibilites') ?? ''),
        tarifLu: String(donnees.get('tarifLu') ?? ''),
        message: String(donnees.get('message') ?? '').trim(),
        consentement: donnees.get('consentement') === 'on',
        societe: String(donnees.get('societe') ?? ''),
        rendu,
      };

      let valide = true;
      if (charge.nom.length < 2) {
        poserErreur('nom', 'Indiquez votre prénom et votre nom.');
        valide = false;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(charge.email)) {
        poserErreur('email', 'Cette adresse e-mail semble incomplète.');
        valide = false;
      }
      if (charge.telephone.replace(/\D/g, '').length < 9) {
        poserErreur('telephone', 'Ce numéro semble incomplet.');
        valide = false;
      }
      if (!charge.profession) {
        poserErreur('profession', 'Choisissez une profession dans la liste.');
        valide = false;
      }
      if (!charge.disponibilites) {
        poserErreur('disponibilites', 'Indiquez quand vous joindre.');
        valide = false;
      }
      if (!charge.tarifLu) {
        poserErreur('tarifLu', 'Répondez par oui ou par non.');
        valide = false;
      }
      if (!charge.consentement) {
        poserErreur(
          'consentement',
          'Votre accord est nécessaire pour que nous vous rappelions.'
        );
        valide = false;
      }
      if (!valide) {
        formulaire.querySelector('[aria-invalid="true"]')?.focus();
        return;
      }

      const libelleInitial = bouton?.textContent ?? 'Demander à être rappelée';
      if (bouton) {
        bouton.disabled = true;
        bouton.textContent = 'Envoi…';
      }

      try {
        const reponse = await fetch('/api/rdv', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(charge),
        });
        const resultat = await reponse.json().catch(() => ({ ok: false }));

        if (resultat.ok) {
          window.lsbTrack?.('rappel_demande', { page: location.pathname });
          formulaire.hidden = true;
          if (succes) {
            succes.hidden = false;
            succes.setAttribute('tabindex', '-1');
            succes.focus();
          }
          return;
        }

        if (resultat.champ) {
          poserErreur(resultat.champ, resultat.message);
        } else if (messageGlobal) {
          messageGlobal.textContent =
            resultat.message ??
            `L’envoi n’a pas abouti. Réessayez, ou écrivez-nous à ${emailContact}.`;
        }
      } catch {
        if (messageGlobal) {
          messageGlobal.textContent = `L’envoi n’a pas abouti. Réessayez, ou écrivez-nous à ${emailContact}.`;
        }
      } finally {
        if (bouton) {
          bouton.disabled = false;
          bouton.textContent = libelleInitial;
        }
      }
    });
  }
</script>
