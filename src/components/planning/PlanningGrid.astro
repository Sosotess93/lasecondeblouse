---
import PlanningCell from './PlanningCell.astro';
import { JOURS, etatDe, semaines } from './roulement';

interface Props {
  /** Nombre de semaines rendues. 4 = un mois. */
  semainesAffichees?: number;
  /** Semaines visibles sous 768px, le reste est masqué en CSS. */
  semainesMobile?: number;
  anime?: boolean;
  legendeAvant?: string;
  legendeApres?: string;
  class?: string;
}

const {
  semainesAffichees = 4,
  semainesMobile = 2,
  anime = false,
  legendeAvant,
  legendeApres,
  class: classe = '',
} = Astro.props;

/**
 * Un roulement de service se lit comme une bande : les jours du mois en
 * colonnes, de gauche à droite. C’est cette lecture qui est reprise sur
 * desktop (28 colonnes). Sous 768px la bande se replie en semaines
 * empilées de 7 colonnes, comme sur un planning mural.
 */
const lignes = semaines(semainesAffichees);
const jours = lignes.flat();
const enTetes = lignes.flatMap(() => JOURS);

/* Délai après l'entrée de la grille dans le viewport, et non après le
   chargement : la grille se trouve sous la ligne de flottaison, y compris
   sur desktop. Déclenchée au chargement, la séquence serait terminée avant
   que qui que ce soit ne la voie. */
const DEPART = 600;
const ETALEMENT = 1120; // ms entre la première cellule et la dernière
const TRANSITION = 350; // durée de vidage d'une cellule

/**
 * Répartition des délais en courbe plutôt qu'en pas constant.
 *
 * À 40 ms fixes par cellule, la vague battait la mesure comme un métronome :
 * l'œil entendait la machine. Un smoothstep la fait démarrer doucement,
 * balayer le milieu du mois, puis se poser sur les derniers jours. Même durée
 * totale, geste beaucoup moins mécanique.
 */
function delaiCellule(index: number, total: number): number {
  if (total <= 1) return 0;
  const t = index / (total - 1);
  return Math.round(ETALEMENT * t * t * (3 - 2 * t));
}

const dureeCascade = ETALEMENT + TRANSITION;

const cellulesMobile = semainesMobile * JOURS.length;
---

<figure class:list={['not-prose', classe]}>
  <div
    class:list={['grille-planning', { anime }]}
    data-grille-planning
    data-depart={anime ? DEPART : undefined}
    data-duree={anime ? dureeCascade : undefined}
    style={`--colonnes: ${jours.length}`}
    aria-hidden="true"
  >
    <div class="bande entete">
      {enTetes.map((jour) => <span class="jour">{jour}</span>)}
    </div>

    <div class="bande cellules">
      {
        jours.map((poste, index) => (
          <PlanningCell
            valeur={poste}
            etat={etatDe(poste)}
            delai={anime ? delaiCellule(index, jours.length) : 0}
            class={index >= cellulesMobile ? 'hors-mobile' : ''}
          />
        ))
      }
    </div>
  </div>

  {
    (legendeAvant || legendeApres) && (
      <figcaption
        class="mt-4 font-mono text-[0.75rem] leading-relaxed tracking-[0.04em] text-encre-500"
        data-legende-planning
        data-apres={legendeApres}
      >
        <span data-texte-legende>{legendeAvant ?? legendeApres}</span>
      </figcaption>
    )
  }
</figure>

<style>
  /* La légende basculait d'un texte à l'autre d'un coup, juste après une
     séquence entièrement animée. C'est pourtant le moment où la grille
     délivre son propos : elle mérite le même soin. */
  [data-texte-legende] {
    display: inline-block;
    transition: opacity 260ms var(--ease-doux);
  }

  .grille-planning {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: fit-content;
  }

  .bande {
    display: grid;
    grid-template-columns: repeat(7, auto);
    gap: 4px;
  }

  .jour {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-encre-500);
  }

  /* Mobile : deux semaines empilées, en-tête sur une seule ligne. */
  .entete > :nth-child(n + 8),
  .cellules > :global(.hors-mobile) {
    display: none;
  }

  /* Desktop : la bande se déplie, un mois entier de gauche à droite. */
  @media (min-width: 768px) {
    .bande {
      grid-template-columns: repeat(var(--colonnes), auto);
      gap: 3px;
    }

    .grille-planning {
      gap: 5px;
    }

    .jour {
      width: 32px;
      font-size: 10px;
    }

    .entete > :nth-child(n + 8),
    .cellules > :global(.hors-mobile) {
      display: inline-flex;
    }

    /* Respiration entre les semaines, sans trait : un planning de service
       sépare les semaines par un blanc, pas par une bordure. */
    .bande > :nth-child(7n + 1):not(:first-child) {
      margin-left: 9px;
    }
  }
</style>

<script>
  const grilles = document.querySelectorAll<HTMLElement>(
    '[data-grille-planning].anime'
  );
  const mouvementReduit = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  grilles.forEach((grille) => {
    const figure = grille.closest('figure');
    const legende = figure?.querySelector<HTMLElement>('[data-legende-planning]');
    const texteApres = legende?.dataset.apres;

    const texte = legende?.querySelector<HTMLElement>('[data-texte-legende]');

    const basculerLegende = () => {
      if (!texte || !texteApres) return;
      texte.style.opacity = '0';
      window.setTimeout(() => {
        texte.textContent = texteApres;
        texte.style.opacity = '1';
      }, 260);
    };

    if (mouvementReduit || !('IntersectionObserver' in window)) {
      // État final immédiat : grille vidée, légende d’après.
      grille.classList.add('est-liberee');
      basculerLegende();
      return;
    }

    const depart = Number(grille.dataset.depart ?? 600);
    const duree = Number(grille.dataset.duree ?? 1400);

    const liberer = () => {
      window.setTimeout(() => {
        grille.classList.add('est-liberee');
        window.setTimeout(basculerLegende, duree);
      }, depart);
    };

    const observateur = new IntersectionObserver(
      (entrees) => {
        entrees.forEach((entree) => {
          if (!entree.isIntersecting && entree.boundingClientRect.top >= 0) return;
          observateur.unobserve(entree.target);
          liberer();
        });
      },
      // La bande doit être largement visible avant de commencer à se vider.
      { threshold: 0.6 }
    );

    observateur.observe(grille);
  });
</script>
