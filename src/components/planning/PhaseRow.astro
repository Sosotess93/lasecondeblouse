---
interface Props {
  numero: string;
  titre: string;
  /** Bloc « ni mission, ni contrat, ni revenu », rendu en texte plein. */
  avertissement?: string;
}

const { numero, titre, avertissement } = Astro.props;
---

<article
  class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-3 border-t border-papier-200 py-8 md:gap-x-8 md:py-10"
>
  <span
    class="mt-1 inline-flex h-8 w-8 items-center justify-center rounded-[2px] border border-or-500 font-mono text-[0.8125rem] text-or-600 md:h-10 md:w-10 md:text-[0.9375rem]"
    aria-hidden="true">{numero}</span
  >

  <h3 class="self-center text-[1.15rem] md:text-[1.4rem]">
    <span class="sr-only">Phase {numero} : </span>{titre}
  </h3>

  <div class="col-start-2 mesure space-y-4 text-encre-700">
    <slot />
    {
      avertissement && (
        <p class="border-l-2 border-or-500 pl-4 font-semibold text-encre-900">
          {avertissement}
        </p>
      )
    }
  </div>
</article>
