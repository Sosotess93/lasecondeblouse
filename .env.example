# Copier en .env, ne jamais commiter .env

# --- Brevo : envoi du guide et gestion des contacts
BREVO_API_KEY=
BREVO_LIST_ID=
# Liste dédiée aux demandes de rappel. À défaut, BREVO_LIST_ID est utilisée.
BREVO_LIST_RDV_ID=

# --- Agenda de prise de rendez-vous
# URL complète Calendly, ou identifiant Cal.com au format "utilisateur/evenement".
# La bio Instagram d'Oumaya pointe aujourd'hui vers :
#   https://calendly.com/contact-lasecondeblouse/30min   [À CONFIRMER]
PUBLIC_AGENDA_URL=

# --- Mesure d'audience sans cookie. Laisser vide pour désactiver
# (aucun traceur, aucun bandeau cookies).
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=
